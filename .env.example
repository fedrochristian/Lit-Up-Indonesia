# Names only. Values live in Vercel (Preview AND Production) and in a local .env.local
# that is never committed. Numeric keys fall back to the MD v1.1 defaults shown in
# docs/DEPLOY-RUNBOOK.md when left empty.

# Gemini API (Guruku). Key must be PAID tier (QA condition (a)).
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase (Singapore, ap-southeast-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Identity and access
ACCOUNT_HMAC_KEY=
ALLOWLIST_EMAILS=
PILOT_CAPS_LIFTED=
NEXT_PUBLIC_SITE_URL=

# Alerts (Rp4m monthly alert)
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=

# Per-call limits
MAX_OUTPUT_TOKENS=
SHORT_RESPONSE_MAX_TOKENS=
THINKING_TOKENS_ALLOWANCE=
MAX_INPUT_TOKENS=
PER_CALL_RESERVE_IDR=

# Caps and rate limits
TRIAL_SESSION_MSG_CAP=
PILOT_DAILY_MSG_CAP=
FREE_MONTHLY_SHORT_CAP=
RATE_LIMIT_USER_PER_MIN=
RATE_LIMIT_IP_PER_MIN=

# Economics (LU-STOP-RULES-20261120-2153)
USD_IDR_RATE=
COST_P95_TRIAL_MAX_IDR=
MONTHLY_BURN_ALERT_IDR=
MONTHLY_BURN_HARD_STOP_IDR=
TRIGGER_CONVERSION_ENABLED=
TRIGGER_MAU_ENABLED=
